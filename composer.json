{
    "name": "zakobo/laravel-jsonapi-query",
    "version": "0.1.8",
    "description": "JSON:API query parameter handling for Laravel 13",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Zakobo\\JsonApiQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zakobo\\JsonApiQuery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "lint": [
            "./vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "./vendor/bin/pint --test"
        ],
        "lint:dirty": [
            "./vendor/bin/pint --dirty"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zakobo\\JsonApiQuery\\JsonApiQueryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
